SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
# 数据库连接
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=FunChinese
DB_USER=root
DB_PASSWORD=your-db-password
# 阿里云百炼（语音合成 TTS）
DASHSCOPE_API_KEY=
